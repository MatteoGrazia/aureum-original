{
  "name": "Routine",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Routine name"
    },
    "description": {
      "type": "string"
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "exercise_id": {
            "type": "string"
          },
          "exercise_name": {
            "type": "string"
          },
          "sets": {
            "type": "number"
          },
          "reps": {
            "type": "string"
          },
          "is_superset": {
            "type": "boolean"
          },
          "superset_with": {
            "type": "string"
          }
        }
      },
      "description": "List of exercises in this routine"
    },
    "target_muscles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Primary muscles targeted"
    }
  },
  "required": [
    "name"
  ]
}