{
  "name": "SyndicateNotification",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string",
      "description": "User receiving the notification"
    },
    "sender_id": {
      "type": "string",
      "description": "User who triggered the notification"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_avatar": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "syndicate_join",
        "voltage",
        "connection_request"
      ],
      "description": "Notification type"
    },
    "message": {
      "type": "string",
      "description": "Notification text"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string",
      "description": "Navigation link for the notification"
    }
  },
  "required": [
    "recipient_id",
    "type",
    "message"
  ]
}