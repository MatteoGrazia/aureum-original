{
  "name": "FoodLog",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "meal_type": {
      "type": "string",
      "enum": [
        "breakfast",
        "lunch",
        "dinner",
        "snack"
      ]
    },
    "food_name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "serving_size": {
      "type": "number"
    },
    "serving_unit": {
      "type": "string"
    },
    "calories": {
      "type": "number"
    },
    "protein": {
      "type": "number"
    },
    "carbs": {
      "type": "number"
    },
    "fat": {
      "type": "number"
    },
    "fiber": {
      "type": "number"
    },
    "barcode": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "food_name",
    "calories"
  ]
}